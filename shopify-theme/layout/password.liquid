<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#121926">
    <link rel="canonical" href="{{ canonical_url }}">
    <title>{{ page_title }} &ndash; {{ shop.name }}</title>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <style>
      @font-face {
        font-family: "Pixel Operator";
        src: url("{{ 'PixelOperator.ttf' | asset_url }}") format("truetype");
        font-weight: 400;
        font-display: block;
      }
      @font-face {
        font-family: "Pixel Operator";
        src: url("{{ 'PixelOperator-Bold.ttf' | asset_url }}") format("truetype");
        font-weight: 700;
        font-display: block;
      }
      @font-face {
        font-family: "Alagard";
        src: url("{{ 'alagard.ttf' | asset_url }}") format("truetype");
        font-weight: 400;
        font-display: block;
      }
    </style>

    <link rel="stylesheet" href="{{ 'base.css' | asset_url }}">
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

    {{ content_for_header }}
  </head>

  <body class="template-password">
    <main id="MainContent" role="main">
      {{ content_for_layout }}
    </main>
  </body>
</html>
