<div class="container">
  <div class="customer customer--wide">
    <h1 class="customer__title">{{ 'customer.account.title' | t }}</h1>

    <p class="customer__meta">
      {{ customer.email }} &middot;
      <a href="{{ routes.account_addresses_url }}" class="link-underline">{{ 'customer.account.addresses' | t }}</a> &middot;
      <a href="{{ routes.account_logout_url }}" class="link-underline">{{ 'customer.account.log_out' | t }}</a>
    </p>

    <h2 class="footer__heading">{{ 'customer.orders.title' | t }}</h2>

    {%- if customer.orders.size > 0 -%}
      <table class="cart__table">
        <thead>
          <tr>
            <th>{{ 'customer.orders.order_number' | t }}</th>
            <th>{{ 'customer.orders.date' | t }}</th>
            <th>{{ 'customer.orders.fulfillment_status' | t }}</th>
            <th class="text-right">{{ 'customer.orders.total' | t }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for order in customer.orders -%}
            <tr>
              <td><a href="{{ order.customer_url }}" class="link-underline">{{ order.name }}</a></td>
              <td>{{ order.created_at | date: format: 'date' }}</td>
              <td>{{ order.fulfillment_status_label }}</td>
              <td class="text-right">{{ order.total_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    {%- else -%}
      <p class="customer__meta">{{ 'customer.orders.none' | t }}</p>
    {%- endif -%}
  </div>
</div>
