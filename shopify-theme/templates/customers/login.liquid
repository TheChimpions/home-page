<div class="container">
  <div class="customer">
    <h1 class="customer__title">{{ 'customer.login.title' | t }}</h1>

    {% form 'customer_login' %}
      {%- if form.errors -%}
        <p class="notice notice--error">{{ form.errors | default_errors }}</p>
      {%- endif -%}

      <div class="field">
        <label class="field__label" for="CustomerEmail">{{ 'customer.login.email' | t }}</label>
        <input class="input" type="email" name="customer[email]" id="CustomerEmail" autocomplete="email" required>
      </div>

      {%- if form.password_needed -%}
        <div class="field">
          <label class="field__label" for="CustomerPassword">{{ 'customer.login.password' | t }}</label>
          <input class="input" type="password" name="customer[password]" id="CustomerPassword" autocomplete="current-password">
        </div>
        <a href="#recover" class="link-underline">{{ 'customer.login.forgot_password' | t }}</a>
      {%- endif -%}

      <button type="submit" class="btn btn--primary">{{ 'customer.login.sign_in' | t }}</button>
    {% endform %}

    <p class="customer__meta">
      {{ 'customer.login.new_customer' | t }}
      <a href="{{ routes.account_register_url }}" class="link-underline">{{ 'customer.register.title' | t }}</a>
    </p>
  </div>

  <div class="customer" id="recover">
    <h2 class="customer__title">{{ 'customer.recover_password.title' | t }}</h2>
    {% form 'recover_customer_password' %}
      {%- if form.posted_successfully? -%}
        <p class="notice notice--success">{{ 'customer.recover_password.success' | t }}</p>
      {%- endif -%}
      <div class="field">
        <label class="field__label" for="RecoverEmail">{{ 'customer.login.email' | t }}</label>
        <input class="input" type="email" name="email" id="RecoverEmail" autocomplete="email" required>
      </div>
      <button type="submit" class="btn">{{ 'customer.recover_password.submit' | t }}</button>
    {% endform %}
  </div>
</div>
