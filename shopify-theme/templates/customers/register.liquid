<div class="container">
  <div class="customer">
    <h1 class="customer__title">{{ 'customer.register.title' | t }}</h1>

    {% form 'create_customer' %}
      {%- if form.errors -%}
        <p class="notice notice--error">{{ form.errors | default_errors }}</p>
      {%- endif -%}

      <div class="field">
        <label class="field__label" for="RegisterFirstName">{{ 'customer.register.first_name' | t }}</label>
        <input class="input" type="text" name="customer[first_name]" id="RegisterFirstName" autocomplete="given-name">
      </div>
      <div class="field">
        <label class="field__label" for="RegisterLastName">{{ 'customer.register.last_name' | t }}</label>
        <input class="input" type="text" name="customer[last_name]" id="RegisterLastName" autocomplete="family-name">
      </div>
      <div class="field">
        <label class="field__label" for="RegisterEmail">{{ 'customer.login.email' | t }}</label>
        <input class="input" type="email" name="customer[email]" id="RegisterEmail" autocomplete="email" required>
      </div>
      <div class="field">
        <label class="field__label" for="RegisterPassword">{{ 'customer.login.password' | t }}</label>
        <input class="input" type="password" name="customer[password]" id="RegisterPassword" autocomplete="new-password">
      </div>

      <button type="submit" class="btn btn--primary">{{ 'customer.register.submit' | t }}</button>
    {% endform %}
  </div>
</div>
