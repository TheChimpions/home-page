<section class="stats">
  <div class="gradient-rail" aria-hidden="true"></div>

  <div class="stats__inner">
    {%- for block in section.blocks -%}
      <div class="stat" {{ block.shopify_attributes }}>
        <span class="stat__label">{{ block.settings.label }}</span>
        {%- if block.settings.count_to > 0 -%}
          <span
            class="stat__value"
            data-countup="{{ block.settings.count_to }}"
            data-decimals="{{ block.settings.decimals }}"
            data-prefix="{{ block.settings.prefix }}"
            data-suffix="{{ block.settings.suffix }}"
          >
            {{- block.settings.prefix }}0{{ block.settings.suffix -}}
          </span>
        {%- elsif block.settings.link != blank -%}
          <a href="{{ block.settings.link }}" class="stat__value">{{ block.settings.value }}</a>
        {%- else -%}
          <span class="stat__value">{{ block.settings.value }}</span>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Stats bar",
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Collection size"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "info": "Used when \"Count up to\" is 0.",
          "default": "222"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "number",
          "id": "count_to",
          "label": "Count up to",
          "info": "Set to 0 to show the plain value instead."
        },
        {
          "type": "range",
          "id": "decimals",
          "label": "Decimals",
          "min": 0,
          "max": 2,
          "step": 1,
          "default": 0
        },
        {
          "type": "text",
          "id": "prefix",
          "label": "Prefix"
        },
        {
          "type": "text",
          "id": "suffix",
          "label": "Suffix"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Stats bar",
      "blocks": [
        {
          "type": "stat",
          "settings": { "label": "Chimpions", "count_to": 222 }
        },
        {
          "type": "stat",
          "settings": { "label": "1/1 artworks", "value": "100%" }
        },
        {
          "type": "stat",
          "settings": { "label": "Launched", "value": "2022" }
        },
        {
          "type": "stat",
          "settings": { "label": "Built on", "value": "Solana" }
        }
      ]
    }
  ]
}
{% endschema %}
