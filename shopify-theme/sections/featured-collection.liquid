{%- liquid
  assign collection = collections[section.settings.collection]
  assign limit = section.settings.products_to_show
-%}

<section class="section{% if section.settings.raised %} section--raised{% endif %}">
  <div class="container section__inner">
    <div class="section-head">
      <h2 class="section-title section-title--sm">
        {{ section.settings.heading }}
        {%- if section.settings.heading_highlight != blank -%}
          <span class="grad-text">{{ section.settings.heading_highlight }}</span>
        {%- endif -%}
      </h2>
      {%- if section.settings.subheading != blank -%}
        <p class="section-subtitle section-head__text">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    {%- if collection.products.size > 0 -%}
      <div class="product-grid product-grid--4">
        {%- for product in collection.products limit: limit -%}
          {%- assign card_delay = forloop.index0 | times: 60 -%}
          {% render 'product-card', product: product, delay: card_delay %}
        {%- endfor -%}
      </div>

      {%- if section.settings.show_view_all -%}
        <div class="center-row">
          <a href="{{ collection.url }}" class="btn">{{ 'collections.general.view_all' | t }}</a>
        </div>
      {%- endif -%}
    {%- else -%}
      <div class="product-grid product-grid--4">
        {%- for i in (1..4) -%}
          <div class="product-card">
            <div class="product-card__media">
              {{ 'product-apparel-' | append: i | placeholder_svg_tag }}
            </div>
            <div class="product-card__body">
              <h3 class="product-card__title">{{ 'onboarding.product_title' | t }}</h3>
              <div class="price">{{ 1999 | money }}</div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The "
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Gradient heading",
      "default": "Merch"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Wearable pixels, printed in small runs"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show \"view all\" button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "raised",
      "label": "Use lighter background",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
