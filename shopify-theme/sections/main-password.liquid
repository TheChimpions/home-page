<div class="hero hero--mobile password-hero">
  <img src="{{ 'hero-bg.png' | asset_url }}" alt="" class="hero__bg" width="1920" height="700">

  <div class="hero__inner">
    <div class="hero__copy">
      <img src="{{ 'logo-header.png' | asset_url }}" alt="{{ shop.name | escape }}" width="152" height="90" class="pixelated">

      <h1 class="hero__title">
        {{ section.settings.heading }}<br>
        <span class="grad-text">{{ shop.name }}</span>
      </h1>

      {%- if shop.password_message != blank -%}
        <div class="rte hero__text">{{ shop.password_message }}</div>
      {%- endif -%}

      {% form 'storefront_password' %}
        {%- if form.errors -%}
          <p class="notice notice--error">{{ form.errors.messages.form }}</p>
        {%- endif -%}
        <div class="password-form">
          <label class="visually-hidden" for="Password">{{ 'general.password_page.password_label' | t }}</label>
          <input class="input" type="password" name="password" id="Password" autocomplete="current-password">
          <button type="submit" class="btn btn--primary">{{ 'general.password_page.enter' | t }}</button>
        </div>
      {% endform %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Password",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Opening soon"
    }
  ]
}
{% endschema %}
