{%- paginate search.results by 24 -%}
  <div class="container">
    <div class="collection-head">
      <h1 class="collection-head__title">{{ 'general.search.title' | t }}</h1>

      <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
        <label class="visually-hidden" for="SearchInput">{{ 'general.search.placeholder' | t }}</label>
        <input
          class="input"
          id="SearchInput"
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{{ 'general.search.placeholder' | t }}"
        >
        <button type="submit" class="btn">{{ 'general.search.submit' | t }}</button>
      </form>
    </div>

    {%- if search.performed -%}
      {%- if search.results_count > 0 -%}
        <p class="collection-toolbar">
          {{ 'general.search.results_with_count' | t: terms: search.terms, count: search.results_count }}
        </p>

        <div class="product-grid product-grid--4">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item %}
            {%- else -%}
              <a href="{{ item.url }}" class="article-card">
                <h2 class="article-card__title">{{ item.title }}</h2>
                <p class="text-muted">{{ item.content | strip_html | truncatewords: 24 }}</p>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {% render 'pagination', paginate: paginate %}
      {%- else -%}
        <div class="empty-state">
          <h2 class="empty-state__title">{{ 'general.search.no_results' | t: terms: search.terms }}</h2>
          <a href="{{ routes.all_products_collection_url }}" class="btn">{{ 'collections.general.view_all' | t }}</a>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Search",
  "settings": []
}
{% endschema %}
