<section class="section">
  <div class="container join-cta__section">
    <div class="fade-up">
      <div class="join-cta">
        <div class="gradient-rail join-cta__rail" aria-hidden="true"></div>

        <div class="join-cta__grid">
          <div>
            <h2 class="join-cta__title">{{ section.settings.heading }}</h2>
            {%- if section.settings.text != blank -%}
              <p class="join-cta__text">{{ section.settings.text }}</p>
            {%- endif -%}
          </div>

          <div class="join-cta__actions">
            {%- for block in section.blocks -%}
              <a
                href="{{ block.settings.link | default: routes.root_url }}"
                class="btn"
                {% if block.settings.new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
                {{ block.shopify_attributes }}
              >
                {{ block.settings.label }}
              </a>
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Join CTA",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Want to be part of it?"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Join The Chimpions - grab some merch, stake to our validator, or just vibe in the Treehouse."
    }
  ],
  "blocks": [
    {
      "type": "button",
      "name": "Button",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Shop the merch"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "new_tab",
          "label": "Open in a new tab",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Join CTA",
      "blocks": [
        { "type": "button", "settings": { "label": "Shop the merch" } }
      ]
    }
  ]
}
{% endschema %}
