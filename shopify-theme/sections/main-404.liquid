<div class="container">
  <div class="empty-state">
    <img src="{{ 'logo-bordered.png' | asset_url }}" alt="" width="200" height="200" class="pixelated animate-breathe">
    <h1 class="empty-state__title">
      404 &mdash; <span class="grad-text">{{ 'general.404.title' | t }}</span>
    </h1>
    <p class="text-muted">{{ 'general.404.subtext' | t }}</p>
    <a href="{{ routes.root_url }}" class="btn btn--primary">{{ 'general.404.link' | t }}</a>
  </div>
</div>

