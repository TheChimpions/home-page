<section class="faq">
  <img src="{{ 'purple-light.png' | asset_url }}" alt="" class="faq__glow" width="780" height="1025" loading="lazy">

  <div class="container faq__inner">
    <div class="faq__grid">
      <div>
        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 640 }}"
            alt=""
            class="faq__mascot animate-breathe"
            width="320"
            height="320"
            loading="lazy"
          >
        {%- else -%}
          <img src="{{ 'logo-bordered.png' | asset_url }}" alt="" class="faq__mascot animate-breathe" width="320" height="320" loading="lazy">
        {%- endif -%}
      </div>

      <div>
        <h2 class="faq__title">
          {{ section.settings.heading }}
          {%- if section.settings.heading_highlight != blank -%}
            <span class="grad-text grad-text--gold">{{ section.settings.heading_highlight }}</span>
          {%- endif -%}
        </h2>

        <div data-faq>
          {%- for block in section.blocks -%}
            <div
              class="faq__item fade-up{% if forloop.first %} is-open{% endif %}"
              data-faq-item
              data-delay="{{ forloop.index0 | times: 80 }}"
              {{ block.shopify_attributes }}
            >
              <button
                type="button"
                class="faq__question"
                data-faq-question
                aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}"
              >
                <span>{{ block.settings.question }}</span>
                <img src="{{ 'faq-arrow-down.svg' | asset_url }}" alt="" class="faq__icon" width="30" height="30">
              </button>
              <div class="faq__answer">
                <div class="faq__answer-inner">
                  <div class="rte">{{ block.settings.answer }}</div>
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequent "
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Gradient heading",
      "default": "Questions"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Side image",
      "info": "Leave empty to use the bordered Chimpions logo."
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What are the Chimpions?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>A collection of 222 unique 1/1 hand-drawn pixel NFTs on Solana. It's not just a project — it's a place to build, share, and grow.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "What are the Chimpions?",
            "answer": "<p>A collection of 222 unique 1/1 hand-drawn pixel NFTs on Solana. It's not just a project — it's a place to build, share, and grow.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How long does shipping take?",
            "answer": "<p>Orders ship within 3–5 business days. Delivery is 3–7 days domestically and 7–21 days internationally, depending on the destination.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Do holders get a discount?",
            "answer": "<p>Yes. Chimpion holders get a discount code in the Discord — connect your wallet there and the bot will hand you one.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "What is your returns policy?",
            "answer": "<p>Unworn items can be returned within 30 days of delivery. Reach out through the contact page and we'll sort it out.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
