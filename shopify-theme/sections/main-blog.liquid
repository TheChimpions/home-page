{%- paginate blog.articles by 12 -%}
  <div class="container">
    <div class="collection-head">
      <h1 class="collection-head__title">{{ blog.title }}</h1>
    </div>

    <div class="product-grid product-grid--4">
      {%- for article in blog.articles -%}
        <a href="{{ article.url }}" class="article-card fade-up">
          <span class="article-card__meta">{{ article.published_at | date: format: 'date' }}</span>
          <h2 class="article-card__title">{{ article.title }}</h2>
          <p class="text-muted">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
        </a>
      {%- endfor -%}
    </div>

    {% render 'pagination', paginate: paginate %}
  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Blog",
  "settings": []
}
{% endschema %}
