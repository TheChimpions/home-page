<footer class="footer">
  <div class="footer__inner">
    <div class="footer__grid">
      <div class="footer__brand">
        {%- if section.settings.logo != blank -%}
          <img
            src="{{ section.settings.logo | image_url: width: 240 }}"
            alt="{{ shop.name | escape }}"
            width="{{ section.settings.logo.width }}"
            height="{{ section.settings.logo.height }}"
          >
        {%- else -%}
          <img src="{{ 'logo-footer.svg' | asset_url }}" alt="{{ shop.name | escape }}" width="106" height="63">
        {%- endif -%}

        {%- if section.settings.tagline != blank -%}
          <p class="footer__tagline">{{ section.settings.tagline }}</p>
        {%- endif -%}

        {%- if section.settings.show_newsletter -%}
          {% form 'customer', class: 'newsletter' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <label class="visually-hidden" for="NewsletterEmail">{{ 'newsletter.label' | t }}</label>
            <input
              id="NewsletterEmail"
              class="input"
              type="email"
              name="contact[email]"
              placeholder="{{ 'newsletter.placeholder' | t }}"
              autocomplete="email"
              required
            >
            <button type="submit" class="btn">{{ 'newsletter.button' | t }}</button>
            {%- if form.posted_successfully? -%}
              <p class="notice notice--success">{{ 'newsletter.success' | t }}</p>
            {%- endif -%}
          {% endform %}
        {%- endif -%}
      </div>

      {%- if section.settings.menu_primary != blank -%}
        <div class="footer__column">
          <h3 class="footer__heading">{{ section.settings.menu_primary_title }}</h3>
          <div class="footer__links">
            {%- for link in linklists[section.settings.menu_primary].links -%}
              <a href="{{ link.url }}" class="link-underline">{{ link.title }}</a>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      {%- if section.settings.menu_secondary != blank -%}
        <div class="footer__column footer__column--end">
          <h3 class="footer__heading">{{ section.settings.menu_secondary_title }}</h3>
          <div class="footer__links">
            {%- for link in linklists[section.settings.menu_secondary].links -%}
              <a href="{{ link.url }}" class="link-underline">{{ link.title }}</a>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>

  <div class="footer__divider"><div></div></div>

  <div class="footer__bottom">
    <p class="footer__copyright">
      &copy; {{ 'now' | date: '%Y' }} {{ section.settings.copyright_name | default: shop.name }}
    </p>

    <div class="footer__payment">
      {%- if section.settings.show_payment_icons -%}
        {%- for type in shop.enabled_payment_types -%}
          {{ type | payment_type_svg_tag: class: 'payment-icon' }}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Leave empty to use the pixel Chimpions logo bundled with the theme."
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline",
      "default": "222 unique Chimpions. One powerful DAO.\nBuilt on Solana."
    },
    {
      "type": "header",
      "content": "Menus"
    },
    {
      "type": "text",
      "id": "menu_primary_title",
      "label": "First menu heading",
      "default": "The Chimpions"
    },
    {
      "type": "link_list",
      "id": "menu_primary",
      "label": "First menu",
      "default": "footer"
    },
    {
      "type": "text",
      "id": "menu_secondary_title",
      "label": "Second menu heading",
      "default": "Community"
    },
    {
      "type": "link_list",
      "id": "menu_secondary",
      "label": "Second menu"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show email sign-up",
      "default": true
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "text",
      "id": "copyright_name",
      "label": "Copyright name",
      "default": "Chimpions"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  }
}
{% endschema %}
