<div class="container">
  <div class="collection-head">
    <h1 class="collection-head__title">{{ 'collections.general.all_collections' | t }}</h1>
  </div>

  <div class="product-grid product-grid--4">
    {%- for collection in collections -%}
      <a href="{{ collection.url }}" class="product-card fade-up">
        <div class="product-card__media">
          {%- if collection.featured_image -%}
            <img
              src="{{ collection.featured_image | image_url: width: 700 }}"
              alt="{{ collection.featured_image.alt | escape }}"
              width="700"
              height="700"
              loading="lazy"
            >
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag }}
          {%- endif -%}
        </div>
        <div class="product-card__body">
          <h2 class="product-card__title">{{ collection.title }}</h2>
          <span class="product-card__vendor">
            {{ 'collections.general.product_count' | t: count: collection.products_count }}
          </span>
        </div>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Collections list",
  "settings": []
}
{% endschema %}
